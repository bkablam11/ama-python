      "locked": false
    },
    {
      "id": "VCUMhMZ2M_9gwF0Cu881E",
      "type": "text",
      "x": 1134.4670043837525,
      "y": 648.8092785200065,
      "width": 330.7982177734375,
      "height": 371.43983789154004,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 1095382786,
      "version": 882,
      "versionNonce": 413572382,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788723519686,
      "link": null,
      "locked": false,
      "text": "Faire un petit déjeuner : \nCafé au lait \n\nDébut \n\n    - Chauffer de l'eau \n    - On récupère une tasse \n    \n    SI \n        l'eau est chaude et qu'on a les \n        ingrédients \n    ALORS \n        on mets les ingrédients & l'eau dans la \n        tasse puis on mélange \n    \n    SINON \n        on attends <---\n\nFin\n",
      "fontSize": 14.857593515661602,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Faire un petit déjeuner : \nCafé au lait \n\nDébut \n\n    - Chauffer de l'eau \n    - On récupère une tasse \n    \n    SI \n        l'eau est chaude et qu'on a les \n        ingrédients \n    ALORS \n        on mets les ingrédients & l'eau dans la \n        tasse puis on mélange \n    \n    SINON \n        on attends <---\n\nFin\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
